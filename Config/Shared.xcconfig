// Shared build configuration. Committed.
//
// Signing values default to placeholders suitable only for simulator builds.
// For device builds, copy Config/Signing.xcconfig.example to Config/Signing.xcconfig
// (gitignored) and fill in the owner's team ID and a real reverse-DNS bundle ID.
// The placeholder below is intentionally not a real organization identifier.

QCP_BUNDLE_ID = local.placeholder.QuranCarPlayer
QCP_DEVELOPMENT_TEAM =

// Phone-only signing until the paid Developer Program team can use CarPlay.
// Switch this to App/QuranCarPlayer.entitlements after that entitlement is on the App ID.
// See docs/IMPLEMENTATION.md, "Open: CarPlay".
QCP_CODE_SIGN_ENTITLEMENTS = App/QuranCarPlayerPhone.entitlements

#include? "Signing.xcconfig"
