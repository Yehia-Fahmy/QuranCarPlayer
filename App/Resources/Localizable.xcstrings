    "settings.autoResume" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "متابعة التشغيل تلقائيًا عند الاتصال بـ CarPlay" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Resume automatically when CarPlay connects" } }
      }
    },
    "settings.autoResume.footer" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "عند التفعيل، يستأنف التطبيق آخر سورة من الموضع المحفوظ مرة واحدة عند اتصال السيارة، إذا كان التوقف بسبب فصل السيارة. لا يُستأنف التشغيل بعد إيقاف مؤقت متعمد أو بعد انتهاء سورة الناس. تعتمد السياسة النهائية على اختبار السيارة." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "When on, the app resumes the last surah from its saved position once when the car connects, if playback stopped because the car disconnected. It does not resume after a deliberate pause or after An-Nas has finished. The final policy depends on in-car testing." } }
      }
    },
    "settings.source" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "مصدر الصوت" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Audio source" } }
      }
    },
    "settings.source.fixture" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "هذا الإصدار يشغّل نغمات اختبارية اصطناعية مولّدة داخل المشروع. لا يحتوي على أي تلاوة قرآنية." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This build plays synthetic test tones generated inside the project. It contains no Quran recitation." } }
      }
    },
    "settings.source.mp3quran" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تُبث التلاوة من MP3Quran عند عدم تنزيلها. يمكن حفظ السور التي تختارها على هذا الجهاز للاستماع دون اتصال. يُرجى مراجعة معلومات المصدر والإسناد أدناه." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Recitation streams from MP3Quran when it has not been downloaded. Surahs you choose can be saved on this device for offline listening. See the source attribution below." } }
      }
    },
    "settings.source.mp3quran.streamingOnly" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تُبث التلاوة من MP3Quran. التخزين المحلي غير متاح حاليًا، لذا يحتاج التشغيل إلى اتصال بالإنترنت. يُرجى مراجعة معلومات المصدر والإسناد أدناه." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Recitation streams from MP3Quran. Local storage is currently unavailable, so playback needs an internet connection. See the source attribution below." } }
      }
    },
    "settings.artwork" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "مصادر صور القرّاء" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Reciter portrait sources" } }
      }
    },
    "settings.artwork.footer" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تُنشأ صور السور على الجهاز وتعمل دون اتصال. تُستخدم لوحة كتابية بدلًا من الصورة عندما لا تكون حقوق صورة القارئ موثقة." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Chapter artwork is generated on-device and works offline. Typography replaces the portrait whenever image rights are not documented." } }
      }
    },
    "settings.artwork.source" : {
      "localizations" : {
