    "downloads.footer" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تُحفظ التنزيلات على هذا الجهاز ولا تُضمّن في النسخ الاحتياطية. يستمر البث تلقائيًا عند عدم وجود ملف محفوظ." } },
