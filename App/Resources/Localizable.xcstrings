        "ar" : { "stringUnit" : { "state" : "translated", "value" : "انتهى — تم بلوغ نهاية سورة الناس" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Finished — reached the end of An-Nas" } }
      }
