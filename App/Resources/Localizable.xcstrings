    "settings.carplay" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "CarPlay" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "CarPlay" } }
      }
    },
    "settings.autoResume" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "متابعة التشغيل تلقائيًا عند الاتصال بـ CarPlay" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Resume automatically when CarPlay connects" } }
      }
    },
    "settings.autoResume.footer" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "عند التفعيل، يستأنف التطبيق آخر سورة من الموضع المحفوظ مرة واحدة عند اتصال السيارة، إذا كان التوقف بسبب فصل السيارة. لا يُستأنف التشغيل بعد إيقاف مؤقت متعمد أو بعد انتهاء سورة الناس. تعتمد السياسة النهائية على اختبار السيارة." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "When on, the app resumes the last surah from its saved position once when the car connects, if playback stopped because the car disconnected. It does not resume after a deliberate pause or after An-Nas has finished. The final policy depends on in-car testing." } }
      }
    },
    "settings.source" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "مصدر الصوت" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Audio source" } }
      }
    },
    "settings.source.fixture" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "هذا الإصدار يشغّل نغمات اختبارية اصطناعية مولّدة داخل المشروع. لا يحتوي على أي تلاوة قرآنية." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This build plays synthetic test tones generated inside the project. It contains no Quran recitation." } }
      }
    },
    "settings.source.mp3quran" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "التلاوة تُبث من موقع MP3Quran ولا تُحفظ داخل التطبيق. يحتاج التشغيل إلى اتصال بالإنترنت. المصدر يسمح باستخدام الروابط المنشورة على موقعه. التنزيل للاستخدام دون اتصال غير مضاف." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Recitation is streamed from MP3Quran and is not stored in the app. Playback needs an internet connection. The source allows use of links published on its site. Offline download is not included." } }
      }
    },
    "settings.about" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "حول التطبيق" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "About" } }
      }
    },
    "settings.version" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الإصدار" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Version" } }
      }
    },
    "carplay.listLimit" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "هذه السيارة تحدّ من عدد العناصر المعروضة؛ لا يمكن عرض السور الـ114 كلها هنا. استخدم الهاتف عند التوقف." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This car limits list length; not all 114 surahs can be shown here. Use the phone while parked." } }
      }
    },
    "carplay.ok" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "حسنًا" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "OK" } }
      }
    }
  },
  "version" : "1.0"
